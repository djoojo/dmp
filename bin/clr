#!/usr/bin/env bash
set -euo pipefail
fg()
{
local c
for c in "$@";do
printf '\e[%sm%4s\e[0m' "$c" "$c"
done
printf '\n'
}
bg()
{
printf '\e[%sm    \e[0m' "$@"
printf '\n'
}
num()
{
printf '%4s' "$@"
printf '\n'
}
m()
{
fg {30..37}
fg {90..97}
printf '\n'
num {40..47}
bg {40..47}
bg {100..107}
num {100..107}
}
m "$@"
